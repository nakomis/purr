{
  "name": "purr",
  "private": true,
  "description": "Purr: a serverless replacement for Plane and ATC",
  "type": "module",
  "license": "CC0-1.0",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "depcheck": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
